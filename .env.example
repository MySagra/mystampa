# Base URL of the external API
API_URL=http://localhost:4300

# API key for authenticating against the external API (automated print service)
API_KEY="insert-your-API-key-here-after-the-first-signin-to-admin-panel"

SHOW_NUMBERS=false

# Log verbosity: error, warn, info, http, verbose, debug, silly (default: info)
# debug writes full SSE payloads to the logs, including customer names and notes
LOG_LEVEL=info

# Directory for the daily log files (default: ./logs, /app/logs in Docker)
# LOG_DIR=./logs

# Time zone of log timestamps and of the daily log file boundary
# The Docker image already defaults to Europe/Rome
# TZ=Europe/Rome
